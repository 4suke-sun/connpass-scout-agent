# connpass-scout-agent — 環境変数サンプル
# 実値は .env に記入（.env は絶対にコミットしない）。本番はすべて Secrets Manager 経由。

# --- connpass API v2 ---
CONNPASS_API_KEY=your-connpass-api-key
CONNPASS_API_BASE=https://connpass.com/api/v2
CONNPASS_REQUEST_INTERVAL_SEC=1.0
MAX_KEYWORDS=10

# --- DynamoDB ---
KEYWORDS_TABLE_NAME=connpass-scout-keywords
NOTIFIED_EVENTS_TABLE_NAME=connpass-scout-notified-events
NOTIFIED_TTL_DAYS=30

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_DIGEST_CHANNEL_ID=C0123ABC

# --- AWS / AgentCore ---
AWS_REGION=ap-northeast-1
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:ap-northeast-1:000000000000:runtime/your-runtime-id
SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/000000000000/connpass-scout.fifo
